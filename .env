# Search Settings
SEARCH_ENGINE=duckduckgo
MAX_SEARCH_RESULTS=20
TOP_URLS_TO_VISIT=3

# Save Switches
SAVE_TO_JSON=true
SAVE_TO_MONGO=false
SAVE_TO_CSV=false

# MongoDB (Optional)
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=WEB_CRAWLER
MONGO_COLLECTION=invester_relation_scrapy

# Delay Settings
DELAY_MIN=0.5
DELAY_MAX=1
LONG_DELAY_MIN=0.0
LONG_DELAY_MAX=0.5
LONG_DELAY_AFTER_COUNT=300

#Worker Settings
MAX_WORKERS=70

# Logging
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_FILE_PATH=logs/

# Data Paths
DATA_RAW_PATH=\\192.168.102.233\PrivateShare\Crawler_data\crawler_raw_data\JSON
DATA_RANKED_PATH=\\192.168.102.233\PrivateShare\Crawler_data\crawler_cleaned_data\DATA\Ranked
DATA_CRAWLED_PATH=\\192.168.102.233\PrivateShare\Crawler_data\crawler_cleaned_data\DATA\Crawled
DATA_PDF_LINKS_PATH=\\192.168.102.233\PrivateShare\Crawler_data\crawler_cleaned_data\DATA\Pdf_links
PROGRESS_FILE_PATH=\\192.168.102.233\PrivateShare\Crawler_data\crawler_cleaned_data\DATA\progress.json

# Resume Switch
# true  = resume from where it stopped 
# false = start from beginning 
RESUME=true

# Request Settings
REQUEST_TIMEOUT=30
BATCH_PROCESSING_TIMEOUT=500
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
