# Search Settings
SEARCH_ENGINE=duckduckgo
MAX_SEARCH_RESULTS=20
TOP_URLS_TO_VISIT=3

# Save Switches
SAVE_TO_JSON=true
SAVE_TO_MONGO=false
SAVE_TO_CSV=false

# MongoDB (Optional)
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=WEB_CRAWLER
MONGO_COLLECTION=invester_relation_scrapy

# Delay Settings
DELAY_MIN=0.5
DELAY_MAX=1
LONG_DELAY_MIN=0.0
LONG_DELAY_MAX=0.5
LONG_DELAY_AFTER_COUNT=300

#Worker Settings
MAX_WORKERS=60

# Logging
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_FILE_PATH=logs/

# Data Paths
DATA_RAW_PATH=DATA/Raw
DATA_RANKED_PATH=DATA/Ranked
DATA_CRAWLED_PATH=DATA/Crawled
DATA_PDF_LINKS_PATH=DATA/Pdf_links

# Resume Switch
# true  = resume from where it stopped 
# false = start from beginning 
RESUME=true

# Request Settings
REQUEST_TIMEOUT=30
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
